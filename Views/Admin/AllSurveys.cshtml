@model SurveyApp.ViewModels.AllSurveysViewModel
@{
    ViewData["Title"] = "Tất cả khảo sát";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">
        <i class="bi bi-collection text-primary me-2"></i>Tất cả khảo sát
    </h2>
    <a asp-action="Dashboard" class="btn btn-secondary">
        <i class="bi bi-arrow-left me-1"></i>Quay lại Dashboard
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Tiêu đề</th>
                        <th>Người tạo</th>
                        <th>Ngày tạo</th>
                        <th>Ngày đóng</th>
                        <th>Câu hỏi</th>
                        <th>Trả lời</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Surveys.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                Chưa có khảo sát nào trong hệ thống.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var survey in Model.Surveys)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold max-width-200 text-truncate" title="@survey.Title">
                                    @survey.Title
                                </td>
                                <td>@survey.CreatorName</td>
                                <td class="text-muted small">@survey.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-muted small">
                                    @(survey.ClosedAt.HasValue ? survey.ClosedAt.Value.ToString("dd/MM/yyyy HH:mm") : "-")
                                </td>
                                <td><span class="badge bg-info">@survey.QuestionCount</span></td>
                                <td><span class="badge bg-secondary">@survey.ResponseCount</span></td>
                                <td>
                                    @if (survey.ClosedAt.HasValue && survey.ClosedAt.Value <= DateTime.Now)
                                    {
                                        <span class="badge bg-danger">Đã đóng (hết hạn)</span>
                                    }
                                    else if (survey.IsActive)
                                    {
                                        <span class="badge bg-success">Đang mở</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Tạm khóa</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-controller="Survey" asp-action="Details" asp-route-id="@survey.Id" class="btn btn-outline-primary" title="Chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-controller="Statistics" asp-action="Index" asp-route-surveyId="@survey.Id" class="btn btn-outline-success" title="Thống kê">
                                            <i class="bi bi-bar-chart"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .max-width-200 {
        max-width: 200px;
    }
</style>
