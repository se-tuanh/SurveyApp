@model IEnumerable<SurveyApp.Models.Survey>
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold">Danh sách khảo sát</h2>
        <p class="text-muted mb-0">Tham gia các khảo sát đang diễn ra dưới đây.</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="filterDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-funnel me-1"></i> 
                @(ViewBag.CurrentFilter == "open" ? "Đang mở" : ViewBag.CurrentFilter == "closed" ? "Đã đóng" : "Tất cả")
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="filterDropdown">
                <li><a class="dropdown-item @(ViewBag.CurrentFilter == "all" || string.IsNullOrEmpty(ViewBag.CurrentFilter) ? "active" : "")" asp-action="Index" asp-route-filter="all">Tất cả</a></li>
                <li><a class="dropdown-item @(ViewBag.CurrentFilter == "open" ? "active" : "")" asp-action="Index" asp-route-filter="open">Đang mở</a></li>
                <li><a class="dropdown-item @(ViewBag.CurrentFilter == "closed" ? "active" : "")" asp-action="Index" asp-route-filter="closed">Đã đóng</a></li>
            </ul>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <p class="mt-3 text-muted">Chưa có khảo sát nào đang mở.</p>
        @if (User.Identity!.IsAuthenticated)
        {
            <a asp-controller="Survey" asp-action="Create" class="btn btn-primary">
                Tạo khảo sát mới
            </a>
        }
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var survey in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title fw-bold">
                            @survey.Title
                            @if (survey.ClosedAt.HasValue && survey.ClosedAt.Value <= DateTime.Now)
                            {
                                <span class="badge bg-danger ms-2 fs-6">Đã đóng</span>
                            }
                        </h5>
                        <p class="card-text text-muted small">@(survey.Description ?? "Không có mô tả")</p>
                        <div class="d-flex gap-3 text-muted small mb-3">
                            <span>@survey.Questions.Count câu hỏi</span>
                            <span>@survey.Responses.Count lượt trả lời</span>
                        </div>
                        <p class="text-muted small mb-1">Người tạo: @(survey.CreatedBy?.FullName ?? survey.CreatedBy?.Email)</p>
                        @if (survey.ClosedAt.HasValue && survey.ClosedAt.Value > DateTime.Now)
                        {
                            <p class="text-warning small fw-bold mb-0">
                                <i class="bi bi-clock-history me-1"></i>Đóng lúc: @survey.ClosedAt.Value.ToString("dd/MM/yyyy HH:mm")
                            </p>
                        }
                    </div>
                    <div class="card-footer bg-transparent pb-3">
                        @if (User.Identity!.IsAuthenticated)
                        {
                            bool isClosed = survey.ClosedAt.HasValue && survey.ClosedAt.Value <= DateTime.Now;
                            <a asp-controller="Response" asp-action="Take" asp-route-surveyId="@survey.Id"
                               class="btn @(isClosed ? "btn-secondary disabled" : "btn-primary") btn-sm w-100">
                                @(isClosed ? "Khảo sát đã đóng" : "Tham gia khảo sát")
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm w-100">
                                Đăng nhập để tham gia
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
