@model SurveyApp.Models.Question
@{
    ViewData["Title"] = "Thêm câu hỏi";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-1"><i class="bi bi-question-circle text-primary me-2"></i>Thêm câu hỏi</h4>
                <p class="text-muted small mb-4">Khảo sát: <strong>@ViewBag.SurveyTitle</strong></p>

                <form asp-action="Create" method="post" id="questionForm">
                    <input type="hidden" asp-for="SurveyId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="mb-3">
                        <label asp-for="Text" class="form-label fw-semibold"></label>
                        <input asp-for="Text" class="form-control" placeholder="Nhập nội dung câu hỏi..." />
                        <span asp-validation-for="Text" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="QuestionType" class="form-label fw-semibold"></label>
                        <select asp-for="QuestionType" class="form-select" id="questionTypeSelect"
                                asp-items="Html.GetEnumSelectList<SurveyApp.Models.QuestionType>()"></select>
                    </div>

                    <div id="optionsSection" class="mb-4">
                        <label class="form-label fw-semibold">Các lựa chọn</label>
                        <div id="optionsList">
                            <div class="input-group mb-2">
                                <div class="input-group-text" title="Đánh dấu là đáp án đúng (tùy chọn)">
                                    <input class="form-check-input mt-0" type="radio" name="correctOptionIndex" value="0" aria-label="Đáp án đúng">
                                </div>
                                <input type="text" name="optionTexts" class="form-control" placeholder="Lựa chọn 1 Nội dung" />
                                <button type="button" class="btn btn-outline-danger" onclick="removeOption(this)">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                            <div class="input-group mb-2">
                                <div class="input-group-text" title="Đánh dấu là đáp án đúng (tùy chọn)">
                                    <input class="form-check-input mt-0" type="radio" name="correctOptionIndex" value="1" aria-label="Đáp án đúng">
                                </div>
                                <input type="text" name="optionTexts" class="form-control" placeholder="Lựa chọn 2 Nội dung" />
                                <button type="button" class="btn btn-outline-danger" onclick="removeOption(this)">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        </div>
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="addOption()">
                            <i class="bi bi-plus me-1"></i>Thêm lựa chọn
                        </button>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary fw-semibold">
                            <i class="bi bi-check-circle me-1"></i>Lưu câu hỏi
                        </button>
                        <a asp-controller="Survey" asp-action="Details" asp-route-id="@Model.SurveyId"
                           class="btn btn-secondary">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const typeSelect = document.getElementById('questionTypeSelect');
    const optionsSection = document.getElementById('optionsSection');
    let optionCount = 2;

    function toggleOptions() {
        optionsSection.style.display = typeSelect.value === '0' ? 'block' : 'none';
    }
    typeSelect.addEventListener('change', toggleOptions);
    toggleOptions();

    function addOption() {
        const div = document.createElement('div');
        div.className = 'input-group mb-2';
        div.innerHTML = `
            <div class="input-group-text" title="Đánh dấu là đáp án đúng (tùy chọn)">
                <input class="form-check-input mt-0" type="radio" name="correctOptionIndex" value="${optionCount}" aria-label="Đáp án đúng">
            </div>
            <input type="text" name="optionTexts" class="form-control" placeholder="Lựa chọn ${optionCount + 1} Nội dung" />
            <button type="button" class="btn btn-outline-danger" onclick="removeOption(this)"><i class="bi bi-x"></i></button>`;
        document.getElementById('optionsList').appendChild(div);
        optionCount++;
    }

    function removeOption(btn) {
        btn.closest('.input-group').remove();

        const radios = document.querySelectorAll('input[name="correctOptionIndex"]');
        radios.forEach((radio, index) => {
            radio.value = index;
        });
        optionCount = radios.length;
    }
</script>
}
