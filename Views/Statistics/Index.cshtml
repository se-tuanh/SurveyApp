@model SurveyApp.Models.Survey
@{
    ViewData["Title"] = "Thống kê khảo sát";
    int totalResponses = Model.Responses.Count;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">@Model.Title</h2>
        <p class="text-muted mb-0">Tổng số lượt trả lời: <strong class="text-primary">@totalResponses</strong></p>
    </div>
    <a asp-controller="Survey" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary btn-sm">
        Quay lại
    </a>
</div>

@if (totalResponses == 0)
{
    <div class="text-center py-5 bg-light rounded">
        <p class="mt-3 text-muted">Chưa có ai trả lời khảo sát này.</p>
    </div>
}
else
{
    @for (int i = 0; i < Model.Questions.Count; i++)
    {
        var question = Model.Questions.ElementAt(i);
        <div class="card mb-4">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3">
                    <span class="badge bg-primary me-2">@(i + 1)</span>@question.Text
                    <span class="badge @(question.QuestionType == SurveyApp.Models.QuestionType.MultipleChoice ? "bg-info" : "bg-secondary") ms-2 small">
                        @(question.QuestionType == SurveyApp.Models.QuestionType.MultipleChoice ? "Trắc nghiệm" : "Tự luận")
                    </span>
                </h6>

                @if (question.QuestionType == SurveyApp.Models.QuestionType.MultipleChoice)
                {
                    var allAnswers = Model.Responses.SelectMany(r => r.Answers)
                        .Where(a => a.QuestionId == question.Id).ToList();
                    int answered = allAnswers.Count(a => a.SelectedOptionId.HasValue);

                    <div class="row align-items-center mt-3">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <canvas id="chart_@question.Id" style="max-height: 250px;"></canvas>
                        </div>
                        <div class="col-md-6">
                            <ul class="list-group list-group-flush">
                                @foreach (var option in question.Options)
                                {
                                    int count = allAnswers.Count(a => a.SelectedOptionId == option.Id);
                                    double pct = answered > 0 ? Math.Round((double)count / answered * 100, 1) : 0;
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 bg-transparent border-0 mb-1">
                                        <div>
                                            @if (option.IsCorrect)
                                            {
                                                <i class="bi bi-check-circle-fill text-success me-1" title="Đáp án kỳ vọng"></i>
                                                <span class="fw-bold text-success">@option.Text</span>
                                            }
                                            else
                                            {
                                                <span>@option.Text</span>
                                            }
                                        </div>
                                        <span class="badge bg-primary rounded-pill">@count (@pct%)</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }
                else
                {
                    var textAnswers = Model.Responses.SelectMany(r => r.Answers)
                        .Where(a => a.QuestionId == question.Id && !string.IsNullOrWhiteSpace(a.TextAnswer))
                        .ToList();
                    <p class="text-muted small mb-2">@textAnswers.Count câu trả lời</p>
                    <ul class="list-group list-group-flush">
                        @foreach (var ans in textAnswers)
                        {
                            <li class="list-group-item px-0 py-2 border-0 border-bottom">
                                @ans.TextAnswer
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    }
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const bgColors = [
                'rgba(54, 162, 235, 0.7)',
                'rgba(255, 99, 132, 0.7)',
                'rgba(255, 206, 86, 0.7)',
                'rgba(75, 192, 192, 0.7)',
                'rgba(153, 102, 255, 0.7)',
                'rgba(255, 159, 64, 0.7)'
            ];

            @foreach (var question in Model.Questions.Where(q => q.QuestionType == SurveyApp.Models.QuestionType.MultipleChoice))
            {
                var allAnswers = Model.Responses.SelectMany(r => r.Answers)
                    .Where(a => a.QuestionId == question.Id).ToList();

                var labels = question.Options.Select(o => o.Text).ToList();
                var data = question.Options.Select(o => allAnswers.Count(a => a.SelectedOptionId == o.Id)).ToList();
                var hasData = data.Any(d => d > 0);

                <text>
                if (@hasData.ToString().ToLower()) {
                    new Chart(document.getElementById('chart_@question.Id'), {
                        type: 'pie',
                        data: {
                            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(labels)),
                            datasets: [{
                                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(data)),
                                backgroundColor: bgColors,
                                borderWidth: 1
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    display: false 
                                }
                            }
                        }
                    });
                } else {
                    document.getElementById('chart_@question.Id').outerHTML = '<div class="text-center text-muted p-4"><i class="bi bi-pie-chart text-light fs-1"></i><p class="mt-2 mb-0">Chưa có dữ liệu</p></div>';
                }
                </text>
            }
        });
    </script>
}
